{
  "$schema": "https://turbo.build",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "prettier:write": {
      "dependsOn": []
    },
    "prettier:check": {
      "dependsOn": []
    },
    "lint:fix": {
      "dependsOn": []
    },
    "lint": {
      "dependsOn": []
    },
    "test:unit": {
      "dependsOn": []
    },
    "test:integration": {
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
