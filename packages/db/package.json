{
  "name": "@cg-assignment/db",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "test:unit": "echo \"Skipping unit tests\"",
    "test:integration": "echo \"Skipping integration tests\""
  },
  "dependencies": {
    "dotenv": "^18.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.13"
  }
}
